// Generates the DS12 timing table (PROTOCOL.md rules 2, 5 and 9) from the filed raw file
// docs/acceptance/2026-10-20-live-suite/ui-timings.json, with the harness's statistics (tasks/statistics.ts), and writes
// docs/acceptance/2026-10-20-live-suite/ui-timings-table.md. Each measure stays on one clock: click to confirmed and
// confirmed to verified on the Playwright process clock, panel mounted to delivered on the browser clock.
//   cd smart_contracts && npx ts-node --transpile-only --project tsconfig.json ../docs/acceptance/automation/eval3/ds12-table.cts
import { readFileSync, writeFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { summarize } from '../../../../smart_contracts/tasks/statistics'

const DIR = resolve(__dirname, '../../2026-10-20-live-suite')
type Obs = {
    operation: string
    direction?: string
    clickAt: string
    confirmedAt: string | null
    verifiedAt: string | null
    outcome: string
    delivery?: { mountedAt: string | null; deliveredAt: string | null }
}
const raw = JSON.parse(readFileSync(`${DIR}/ui-timings.json`, 'utf8')) as {
    header: { startedAt: string; gitSha: string; gitDirty: boolean; deploymentId: string }
    observations: Obs[]
}
const s = (a: string | null | undefined, b: string | null | undefined) =>
    a && b ? (Date.parse(b) - Date.parse(a)) / 1000 : null
const NAME: Record<string, string> = { '421614->84532': 'Arbitrum Sepolia to Base Sepolia', '84532->421614': 'Base Sepolia to Arbitrum Sepolia' }
const groups = new Map<string, Obs[]>()
for (const o of raw.observations) {
    const key = o.operation === 'send' ? `send, ${NAME[o.direction ?? ''] ?? o.direction}` : o.operation
    groups.set(key, [...(groups.get(key) ?? []), o])
}
const f = (v: number) => v.toFixed(2)
const rows: string[] = []
for (const [op, obs] of groups) {
    const measures: [string, string, (o: Obs) => number | null][] = [
        ['click to confirmed', 'Playwright', (o) => s(o.clickAt, o.confirmedAt)],
        ['confirmed to verified', 'Playwright', (o) => s(o.confirmedAt, o.verifiedAt)],
    ]
    if (op.startsWith('send')) measures.push(['panel mounted to delivered', 'browser', (o) => s(o.delivery?.mountedAt, o.delivery?.deliveredAt)])
    for (const [measure, clock, get] of measures) {
        const values = obs.map(get).filter((v): v is number => v != null)
        const missing = obs.length - values.length
        const x = summarize(values)
        const ci = x.medianCi95 ? `${f(x.medianCi95.low)} to ${f(x.medianCi95.high)}` : 'n < 10'
        rows.push(
            `| ${op} | ${measure} | ${clock} | ${x.n}${missing ? ` (${missing} missing)` : ''} | ${f(x.min)} | ${f(x.q1)} | ${f(x.median)} | ${f(x.q3)} | ${f(x.p95)} | ${f(x.max)} | ${x.outliers} | ${ci} |`
        )
    }
}
const outcomes = [...new Set(raw.observations.map((o) => o.outcome))].map(
    (o) => `${raw.observations.filter((x) => x.outcome === o).length} ${o}`
)
const md = [
    '<!-- Generated by docs/acceptance/automation/eval3/ds12-table.cts from ui-timings.json; do not edit by hand. -->',
    '',
    `DS12 UI timings, LIVE (${raw.header.deploymentId}), one run started ${raw.header.startedAt} from commit \`${raw.header.gitSha.slice(0, 7)}\`${raw.header.gitDirty ? ' (dirty)' : ''}, window ds12. Seconds. Observations: ${outcomes.join(', ')}. Quartiles and p95 by linear interpolation; outliers outside the Tukey fences, reported, not removed; median 95% CI by percentile bootstrap (2,000 resamples, seed 1), only for n ≥ 10.`,
    '',
    '| Operation | Measure | Clock | n | min | Q1 | median | Q3 | p95 | max | outliers | median 95% CI |',
    '| --- | --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | --- |',
    ...rows,
    '',
].join('\n')
writeFileSync(`${DIR}/ui-timings-table.md`, md)
console.log(md)
