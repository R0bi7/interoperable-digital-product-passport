# Copy to .env.local: Ponder 0.18 loads .env.local only, not .env.

# RPC URL per chain id in the deployment manifest. Use a keyed provider (Infura, dRPC, Alchemy):
# public testnet RPCs cap eth_getLogs ranges; Base Sepolia accepted 100 blocks after refusing 500
# during the 2026-10-19 preflight. This is an endpoint observation, not a universal chain limit.
PONDER_RPC_URL_421614=
PONDER_RPC_URL_84532=
PONDER_RPC_URL_11155111=

# Optional maximum eth_getLogs range, in blocks, per chain. Unset = provider auto-detection.
# Use only ranges supported by your provider. A provider must retain logs from deployment;
# reducing the range cannot recover pruned history. Larger supported ranges speed up backfill.
# PONDER_LOG_BLOCK_RANGE_421614=1000000
# PONDER_LOG_BLOCK_RANGE_84532=1000000
# PONDER_LOG_BLOCK_RANGE_11155111=100000

# Optional interval between RPC request starts (milliseconds), per chain.
# Spaces request starts before their HTTP timeout; responses may overlap.
# PONDER_RPC_INTERVAL_MS_421614=500
# PONDER_RPC_INTERVAL_MS_84532=500
# PONDER_RPC_INTERVAL_MS_11155111=500

# Postgres URL. Unset = embedded PGlite in .ponder/ (persist that folder between runs).
DATABASE_URL=

# Schema name. `ponder start` needs it (or --schema). Reuse it on ordinary restarts;
# use a distinct name when changing deployments.
# DATABASE_SCHEMA=idpp

# Internal progress URL; independent of incoming Host headers.
# Default: http://127.0.0.1:<actual listening port>/status. Ponder 0.18 honours PORT.
# The actual local TCP socket port also handles Ponder’s automatic occupied-port fallback.
# PORT=42069
# INDEXER_STATUS_URL=http://127.0.0.1:42069/status
