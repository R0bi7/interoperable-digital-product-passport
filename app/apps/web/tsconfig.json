{
  "extends": "@idpp/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "e2e-live/**/*.ts",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules"]
}
