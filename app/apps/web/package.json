{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "checkTs": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "NEXT_PUBLIC_BASE_URL=http://localhost:3111 NEXT_PUBLIC_INDEXER_URL= next build && playwright test",
    "test:e2e:live": "NEXT_PUBLIC_INDEXER_URL=${INDEXER_URL:-} next build && playwright test -c playwright.live.config.ts",
    "test:e2e:indexer": "NEXT_PUBLIC_INDEXER_URL=${INDEXER_URL:-http://localhost:42069} next build && playwright test -c playwright.indexer.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@idpp/passport-config": "workspace:*",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "pinata": "2.5.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "2.57.4",
    "wagmi": "2.19.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@idpp/typescript-config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "postcss": "8.5.29",
    "shadcn": "^4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
