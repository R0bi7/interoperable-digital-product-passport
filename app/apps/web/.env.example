# Server only (never exposed to the browser)
# Required by the API routes; left empty so an unedited copy fails validation.
OPERATOR_PRIVATE_KEY=
ISSUER_ALLOWLIST=
PINATA_JWT=
# Upload path for /api/mint and /api/pin: sdk (default) or legacy. Both were verified live on
# 2026-10-12; re-check with `PINATA_UPLOAD_PATH=both PINATA_JWT=… pnpm --filter @idpp/passport-config test:int`.
PINATA_UPLOAD_PATH=sdk
# Optional: requests per minute and client IP before 429, counted separately for GET /api/pin/challenge
# and POST /api/pin (default 20). In memory, per server process; trusts X-Forwarded-For.
# PIN_RATE_LIMIT_PER_MINUTE=20
# Optional server RPC overrides; unset means viem's default public RPC for the chain. The values below
# are the public endpoints checked on 2026-10-19. Use a keyed provider for anything long-lived.
# RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
# RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Public (inlined into the browser bundle)
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud
# Base URL of the indexer's summary API. Unset or empty = mock mode: the read pages show fixtures
# (with a banner), the delivery panel makes no indexer request. Set it to use a running indexer.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional absolute HTTP(S) origin printed in passport QR labels (no path/query/fragment).
# Falls back to the browser origin; the URL also carries the deployment id.
# NEXT_PUBLIC_BASE_URL=https://idpp.example
