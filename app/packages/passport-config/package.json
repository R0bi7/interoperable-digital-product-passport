{
  "name": "@idpp/passport-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "checkTs": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:int": "VITEST_INT=1 vitest run",
    "sync-contracts": "tsx scripts/sync-contracts.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "canonicalize": "5.1.0",
    "multiformats": "14.0.5",
    "viem": "2.57.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@idpp/typescript-config": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "pinata": "2.5.6",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
